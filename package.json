{
  "name": "simplezitie",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run db:init:local && concurrently -k \"wrangler dev --port 8791\" \"vite --host 0.0.0.0 --port 5173\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "db:init:local": "wrangler d1 execute zhitie-db --local --file=./schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5",
    "wrangler": "^4.147.0"
  }
}
